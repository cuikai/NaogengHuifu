.echo {
  font-size: calc(28rpx * var(--fs));
  color: var(--ink2);
  background: var(--bg2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.btn.big { min-height: 128rpx; font-size: calc(38rpx * var(--fs)); margin-top: 16rpx; }

.tile {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--card); border-radius: 32rpx;
  padding: 24rpx 26rpx; margin-bottom: 18rpx;
  box-shadow: var(--sh);
}
.thumbs { display: flex; flex: 0 0 auto; }
.th { width: 96rpx; margin-left: -22rpx; }
.th:first-child { margin-left: 0; }
.tb { flex: 1; min-width: 0; }
.tt { font-size: calc(36rpx * var(--fs)); font-weight: 700; line-height: 1.35; }
.ts { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-top: 4rpx; }
.ts.on { color: var(--ok); font-weight: 600; }
.ar { font-size: calc(40rpx * var(--fs)); color: var(--muted); flex: 0 0 auto; }

.rev {
  background: var(--warn-soft); border: 2rpx solid var(--warn-line);
  border-radius: 28rpx; padding: 26rpx; margin-bottom: 18rpx;
}
.rt { font-size: calc(32rpx * var(--fs)); font-weight: 700; color: var(--warn-ink); }
.rd { font-size: calc(27rpx * var(--fs)); color: var(--warn-ink); opacity: .85; margin-top: 6rpx; line-height: 1.6; }

.row { display: flex; gap: 18rpx; }
.half {
  flex: 1; background: var(--card); border-radius: 32rpx;
  padding: 26rpx; box-shadow: var(--sh);
}

.bar {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--no-soft); border: 2rpx solid var(--no-line);
  border-radius: 28rpx; padding: 22rpx 26rpx; margin-top: 26rpx;
}
.bar-n {
  font-size: calc(34rpx * var(--fs)); font-weight: 700; color: var(--no);
  flex: 0 0 auto; letter-spacing: 1rpx;
}
.bar-b { flex: 1; }
.bar-t { font-size: calc(32rpx * var(--fs)); font-weight: 700; color: var(--no); }
.bar-d { font-size: calc(26rpx * var(--fs)); color: #8a3a30; margin-top: 4rpx; }

.about {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 26rpx; padding: 22rpx 6rpx;
}
.about .lbl { flex: 1; font-size: calc(28rpx * var(--fs)); color: var(--muted); }
