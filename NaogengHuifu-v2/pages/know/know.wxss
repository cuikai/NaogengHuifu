.it {
  display: flex; align-items: center;
  background: var(--card);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 36rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}
.th {
  width: 176rpx; flex: 0 0 auto; margin-right: 26rpx;
  background: var(--blue-soft); border-radius: 26rpx; overflow: hidden;
  display: flex; align-items: center;
}
.it:nth-child(even) .th { background: #fdf3e6; }
.th .imgbox { border-radius: 0; }
.b { flex: 1; min-width: 0; }
.t { font-size: calc(38rpx * var(--fs)); font-weight: 700; line-height: 1.3; }
.d { font-size: calc(28rpx * var(--fs)); color: var(--ink2); margin-top: 10rpx; line-height: 1.55; }
.a { color: #c9c2b1; font-size: calc(40rpx * var(--fs)); flex: 0 0 auto; margin-left: 12rpx; }
