.tk {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--card); border-radius: 28rpx;
  padding: 26rpx 24rpx; margin-bottom: 16rpx;
  box-shadow: var(--sh);
}
.tk.on { background: var(--ok-soft); box-shadow: none; }
.tk .ic { width: 64rpx; height: 64rpx; flex: 0 0 auto; }
.tk .b { flex: 1; min-width: 0; }
.tk .n { font-size: calc(35rpx * var(--fs)); font-weight: 700; line-height: 1.35; }
.tk .d { font-size: calc(26rpx * var(--fs)); color: var(--muted); margin-top: 4rpx; }
.tk .ck {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(28rpx * var(--fs)); color: var(--muted); flex: 0 0 auto;
}
.tk.on .ck { background: var(--ok); color: #fff; box-shadow: none; }

.ds { padding-top: 60rpx; text-align: center; }
.ds-tick {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: var(--ok); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; margin: 0 auto 30rpx;
}
.ds-t { font-size: calc(46rpx * var(--fs)); font-weight: 700; margin-bottom: 14rpx; }
.ds-s { font-size: calc(30rpx * var(--fs)); color: var(--ink2); line-height: 1.8; }
.ds-box { text-align: left; margin: 36rpx 0 28rpx; }
.ds-lb { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-bottom: 12rpx; }
.ds-ta {
  width: 100%; box-sizing: border-box;
  background: var(--card); border-radius: 24rpx; padding: 24rpx;
  font-size: calc(31rpx * var(--fs)); line-height: 1.6; min-height: 120rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
}
.ph { color: var(--muted); }
.ds-rest { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-top: 24rpx; }
.ds-back { font-size: calc(27rpx * var(--fs)); color: var(--blue); margin-top: 36rpx; }
