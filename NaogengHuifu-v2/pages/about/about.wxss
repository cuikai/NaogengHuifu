.blk {
  background: var(--card); border: 0;
  box-shadow: var(--sh);
  border-radius: 36rpx; padding: 32rpx; margin-bottom: 24rpx;
}
.blk.warn { background: var(--warn-soft); box-shadow: none; border: 2rpx solid var(--warn-line); }
.bt { font-size: calc(36rpx * var(--fs)); font-weight: 700; margin-bottom: 16rpx; }
.bp { font-size: calc(30rpx * var(--fs)); color: var(--ink2); line-height: 1.85; margin-top: 14rpx; }
.blk.warn .bp { color: var(--warn-ink); }
.bp .k { font-weight: 700; color: var(--ink); }
.blk.warn .bp .k { color: #8a6516; }

.src { margin-top: 20rpx; border-top: 2rpx solid var(--line2); padding-top: 18rpx; }
.si { font-size: calc(27rpx * var(--fs)); color: var(--muted); line-height: 1.8; }
.si::before { content: '· '; }

.lnk {
  display: block; margin-top: 20rpx; font-size: calc(28rpx * var(--fs)); color: var(--blue-ink);
  background: var(--blue-soft); border-radius: 24rpx; padding: 22rpx 24rpx;
  word-break: break-all;
}

.danger {
  margin-top: 14rpx; text-align: center;
  font-size: calc(30rpx * var(--fs)); color: var(--no);
  border: 2rpx solid var(--no-line); background: var(--no-soft);
  border-radius: 30rpx; padding: 26rpx;
}

.ver { text-align: center; font-size: calc(25rpx * var(--fs)); color: var(--muted); margin-top: 36rpx; }
