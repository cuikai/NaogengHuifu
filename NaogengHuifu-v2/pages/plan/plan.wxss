.mv {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--card); border-radius: 32rpx;
  padding: 18rpx 20rpx; margin-bottom: 18rpx;
  box-shadow: var(--sh);
}
.mv.on { background: var(--ok-soft); box-shadow: none; }
.fg { width: 168rpx; flex: 0 0 auto; }
.mv .b { flex: 1; min-width: 0; }
.mv .n { font-size: calc(36rpx * var(--fs)); font-weight: 700; line-height: 1.35; }
.mv .d { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-top: 4rpx; }
.mv .dose { font-size: calc(27rpx * var(--fs)); color: var(--blue-ink); font-weight: 600; margin-top: 10rpx; }
.mv .ck {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(30rpx * var(--fs)); color: var(--muted); flex: 0 0 auto;
}
.mv.on .ck { background: var(--ok); color: #fff; box-shadow: none; }
