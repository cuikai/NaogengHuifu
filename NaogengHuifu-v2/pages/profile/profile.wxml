<view class="pg flat" style="--fs:{{ui.fs}}">

  <view class="h1">{{weekly ? '这一周的变化' : '这是他现在的位置'}}</view>
  <view class="lead">下面的内容都是按你刚才勾的情况筛出来的。</view>

  <view class="acute" wx:if="{{acute}}">
    <view class="acute-t">发病还不到 2 周</view>
    <view class="acute-p">{{acuteNote}}</view>
  </view>

  <block wx:if="{{urgent.length}}">
    <view class="sec">这几条要先看医生，再决定练不练</view>
    <view class="stop hard" wx:for="{{urgent}}" wx:key="t">
      <view class="t">{{item.t}}　·　{{item.urgentWhen}}</view>
      <view class="r">{{item.urgentDo}}</view>
    </view>
  </block>

  <view class="axis">
    <view class="t">走 · 移动</view>
    <view class="rung">
      <view wx:for="{{mRung}}" wx:key="*this" class="{{item}}"></view>
    </view>
    <view class="now-t">{{mLabel}}</view>
    <view class="nxt">{{mNext}}</view>
  </view>

  <view class="axis">
    <view class="t">手 · 上肢</view>
    <view class="rung">
      <view wx:for="{{hRung}}" wx:key="*this" class="{{item}}"></view>
    </view>
    <view class="now-t">{{hLabel}}</view>
    <view class="nxt">{{hNext}}</view>
  </view>

  <block wx:if="{{rules.length}}">
    <view class="sec">要特别注意的</view>
    <view class="stop" wx:for="{{rules}}" wx:key="t">
      <view class="t">{{item.t}}</view>
      <view class="r">{{item.d}}</view>
    </view>
  </block>

  <view class="sec">今天适合练的</view>
  <view class="card">
    <view class="pt" wx:for="{{plan}}" wx:key="id">
      <view class="n">{{index + 1}}</view>
      <view>
        <view class="p">{{item.name}}</view>
        <view class="q">{{item.sub}}　·　{{item.dose}}</view>
      </view>
    </view>
  </view>

</view>

<view class="dock">
  <view class="btn primary hit" bindtap="go">开始今天的训练</view>
</view>
