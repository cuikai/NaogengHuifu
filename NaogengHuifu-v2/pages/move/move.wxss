.frame {
  background: var(--card);
  border-radius: 32rpx;
  padding: 18rpx;
  box-shadow: var(--sh);
  margin-bottom: 20rpx;
}
.pair { display: flex; gap: 12rpx; }
.pair .col { flex: 1; min-width: 0; }
.cap { font-size: calc(25rpx * var(--fs)); font-weight: 700; margin-top: 10rpx; text-align: center; }
.cap.ok { color: var(--ok); }
.cap.no { color: var(--no); }

.bar { display: flex; gap: 6rpx; margin: 18rpx 0 12rpx; }
.bar .seg { flex: 1; height: 8rpx; border-radius: 4rpx; background: var(--line); overflow: hidden; }
.bar .fill { height: 100%; background: var(--blue); border-radius: 4rpx; }
.phase {
  font-size: calc(33rpx * var(--fs)); font-weight: 600; line-height: 1.5;
  min-height: 96rpx; padding: 0 6rpx;
}

.ctl { display: flex; gap: 12rpx; flex-wrap: wrap; padding: 4rpx 2rpx 2rpx; }
.ctl .c {
  font-size: calc(26rpx * var(--fs)); font-weight: 600;
  padding: 12rpx 22rpx; border-radius: 99rpx;
  background: var(--bg2); color: var(--ink2);
}
.ctl .c.on { background: var(--ink); color: var(--bg); }

.fb { display: flex; gap: 14rpx; }
.fb .f {
  flex: 1; text-align: center;
  padding: 30rpx 8rpx; border-radius: 26rpx;
  background: var(--card); box-shadow: inset 0 0 0 2rpx var(--line);
  font-size: calc(29rpx * var(--fs)); font-weight: 700; line-height: 1.4;
}
.fb .f.on { box-shadow: inset 0 0 0 4rpx var(--blue); background: var(--blue-soft); color: var(--blue-ink); }

.tomorrow {
  margin-top: 20rpx; padding: 26rpx;
  background: var(--blue-soft); border-radius: 28rpx;
}
.tt { font-size: calc(32rpx * var(--fs)); font-weight: 700; color: var(--blue-ink); line-height: 1.55; }
.td { font-size: calc(28rpx * var(--fs)); color: var(--no); margin-top: 10rpx; font-weight: 600; }
