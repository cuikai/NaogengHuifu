.wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;          /* 站姿：方构图 */
  border-radius: 24rpx;
  background: var(--blue-soft);
}
.wrap.wide { padding-top: 34%; }   /* 卧姿：横构图 —— 人躺着占的是宽，不是高 */
.wrap.mid  { padding-top: 62%; }   /* 手部特写 */
.cv { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 24rpx; }
