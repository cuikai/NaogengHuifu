.frame {
  background: var(--card);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 36rpx;
  padding: 20rpx;
  overflow: hidden;
}

.dose { display: flex; flex-wrap: wrap; margin: 26rpx -6rpx 0; }
.chip {
  font-size: calc(28rpx * var(--fs)); font-weight: 600;
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 99rpx; padding: 14rpx 26rpx; margin: 0 6rpx 12rpx;
}

.pts { margin-top: 28rpx; }

.setrow { display: flex; margin-top: 38rpx; }
.setrow .btn { flex: 1; }
.setrow .btn:first-child { margin-right: 18rpx; }

.setnote {
  text-align: center;
  font-size: calc(28rpx * var(--fs));
  color: var(--ink2);
  line-height: 1.7;
  margin-top: 22rpx;
  white-space: pre-line;
}
