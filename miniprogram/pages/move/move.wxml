<view class="pg" style="--fs:{{ui.fs}}" wx:if="{{m}}">

  <view class="h1">{{m.name}}</view>
  <view class="lead">{{m.sub}}</view>

  <view class="frame">
    <view class="imgbox" style="padding-top:{{pad}}">
      <image src="{{m.gif}}" mode="aspectFit" />
    </view>
  </view>

  <view class="dose">
    <text class="chip" wx:for="{{m.dose}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="why">{{m.why}}</view>

  <view class="pts">
    <view class="pt" wx:for="{{m.steps}}" wx:key="*this">
      <view class="n">{{index + 1}}</view>
      <view><view class="p">{{item}}</view></view>
    </view>
    <view class="pt">
      <view class="n bad">!</view>
      <view><view class="p">{{m.note}}</view></view>
    </view>
  </view>

  <view class="stop">
    <view class="t">什么时候必须停</view>
    <view class="r" wx:for="{{stop}}" wx:key="k">
      <text class="k">{{item.k}}</text> —— {{item.v}}
    </view>
  </view>

  <view class="setrow">
    <view class="btn ghost hit {{n <= 0 ? 'dis' : ''}}" bindtap="minus">− 撤销一{{m.unit}}</view>
    <view class="btn hit {{full ? 'ok' : 'primary'}}" bindtap="plus">{{full ? '今天做完了 ✓' : '＋ 做完一' + m.unit}}</view>
  </view>
  <view class="setnote" wx:if="{{full}}">今天 {{m.target}} {{m.unit}}都做完了。做得动可以再来一轮，不用记。{{'\n'}}点绿色按钮可以清零重记。</view>
  <view class="setnote" wx:else>今天已经做了 {{n}} / {{m.target}} {{m.unit}}</view>

</view>
