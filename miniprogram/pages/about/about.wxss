.blk {
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: 28rpx; padding: 28rpx; margin-bottom: 22rpx;
}
.blk.warn { background: var(--warn-soft); border-color: #f0dfae; }
.bt { font-size: calc(36rpx * var(--fs)); font-weight: 700; margin-bottom: 14rpx; }
.bp { font-size: calc(30rpx * var(--fs)); color: var(--ink2); line-height: 1.75; margin-top: 12rpx; }
.blk.warn .bp { color: #5a4a20; }
.bp .k { font-weight: 700; color: var(--ink); }
.blk.warn .bp .k { color: #7a5a10; }

.src { margin-top: 18rpx; border-top: 2rpx solid var(--line); padding-top: 16rpx; }
.si { font-size: calc(27rpx * var(--fs)); color: var(--muted); line-height: 1.7; }
.si::before { content: '· '; }

.lnk {
  margin-top: 18rpx; font-size: calc(28rpx * var(--fs)); color: var(--blue);
  background: var(--blue-soft); border-radius: 18rpx; padding: 18rpx 20rpx;
  word-break: break-all;
}

.danger {
  margin-top: 12rpx; text-align: center;
  font-size: calc(30rpx * var(--fs)); color: var(--no);
  border: 2rpx solid var(--no-line); background: var(--no-soft);
  border-radius: 24rpx; padding: 24rpx;
}

.ver { text-align: center; font-size: calc(25rpx * var(--fs)); color: var(--muted); margin-top: 30rpx; }
