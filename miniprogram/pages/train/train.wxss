.prog { display: flex; align-items: center; margin: 6rpx 0 26rpx; }
.prog-bar { flex: 1; height: 18rpx; border-radius: 99rpx; background: #ece5d6; overflow: hidden; }
.prog-in {
  height: 100%;
  background: linear-gradient(90deg, #7cc09a 0%, var(--ok) 100%);
  border-radius: 99rpx;
  transition: width .3s ease;
}
.prog-n { margin-left: 18rpx; font-size: calc(28rpx * var(--fs)); font-weight: 700; color: var(--ink2); flex: 0 0 auto; }

.mv {
  background: var(--card);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.mv.on { background: #fbfdf9; }

.banner { background: var(--blue-soft); }
.mv.on .banner { background: var(--ok-soft); }
.banner .imgbox { border-radius: 0; }

.row { display: flex; align-items: center; padding: 24rpx 26rpx 8rpx; }
.rowl { flex: 1; min-width: 0; }
.mt { font-size: calc(38rpx * var(--fs)); font-weight: 700; line-height: 1.3; }
.md { font-size: calc(28rpx * var(--fs)); color: var(--ink2); margin-top: 6rpx; }
.mp { font-size: calc(28rpx * var(--fs)); font-weight: 600; color: var(--blue-ink); margin-top: 10rpx; }
.mv.on .mp { color: var(--ok); }

.dose {
  font-size: calc(26rpx * var(--fs)); font-weight: 600;
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 99rpx; padding: 10rpx 20rpx;
  flex: 0 0 auto; margin: 0 16rpx;
  white-space: nowrap;
}

.ck {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  border: 4rpx solid var(--line); background: var(--bg2);
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(34rpx * var(--fs)); font-weight: 700; color: var(--blue-ink);
  transition: background .2s, border-color .2s;
}
.ck.part { border-color: var(--blue); border-width: 6rpx; background: var(--blue-soft); }
.mv.on .ck { background: var(--ok); border-color: var(--ok); color: #fff; }

.hint { font-size: calc(26rpx * var(--fs)); color: var(--muted); padding: 8rpx 26rpx 24rpx; }

.tip {
  font-size: calc(28rpx * var(--fs));
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 28rpx; padding: 24rpx 26rpx; line-height: 1.75; margin-top: 10rpx;
}
