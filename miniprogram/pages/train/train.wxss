.prog { display: flex; align-items: center; margin: 4rpx 0 22rpx; }
.prog-bar { flex: 1; height: 16rpx; border-radius: 99rpx; background: #e8e6de; overflow: hidden; }
.prog-in { height: 100%; background: var(--ok); border-radius: 99rpx; transition: width .25s; }
.prog-n { margin-left: 18rpx; font-size: calc(28rpx * var(--fs)); font-weight: 700; color: var(--ink2); flex: 0 0 auto; }

.mv {
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
}
.mv.on { border-color: var(--ok-line); }

.banner { background: var(--blue-soft); border-bottom: 2rpx solid #e2ebf5; }
.mv.on .banner { background: var(--ok-soft); border-bottom-color: #d7ead7; }
.banner .imgbox { border-radius: 0; }

.row { display: flex; align-items: center; padding: 22rpx 24rpx 6rpx; }
.rowl { flex: 1; min-width: 0; }
.mt { font-size: calc(38rpx * var(--fs)); font-weight: 700; line-height: 1.25; }
.md { font-size: calc(28rpx * var(--fs)); color: var(--ink2); margin-top: 4rpx; }
.mp { font-size: calc(28rpx * var(--fs)); font-weight: 600; color: var(--blue-ink); margin-top: 8rpx; }
.mv.on .mp { color: var(--ok); }

.dose {
  font-size: calc(26rpx * var(--fs)); font-weight: 600;
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 99rpx; padding: 8rpx 18rpx;
  flex: 0 0 auto; margin: 0 16rpx;
  white-space: nowrap;
}

.ck {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  border: 4rpx solid var(--line); background: #fff;
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(34rpx * var(--fs)); font-weight: 700; color: var(--blue);
}
.ck.part { border-color: var(--blue); border-width: 6rpx; }
.mv.on .ck { background: var(--ok); border-color: var(--ok); color: #fff; }

.hint { font-size: calc(26rpx * var(--fs)); color: var(--muted); padding: 6rpx 24rpx 22rpx; }

.tip {
  font-size: calc(28rpx * var(--fs));
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 20rpx; padding: 20rpx 22rpx; line-height: 1.6; margin-top: 6rpx;
}
