.nums { display: flex; margin: 0 -9rpx; }
.nm {
  flex: 1; margin: 0 9rpx;
  background: var(--card); border: 0;
  box-shadow: var(--sh);
  border-radius: 32rpx; padding: 30rpx 10rpx; text-align: center;
}
.nv { font-size: calc(52rpx * var(--fs)); font-weight: 700; color: var(--blue); line-height: 1.1; }
.nl { font-size: calc(24rpx * var(--fs)); color: var(--muted); margin-top: 12rpx; }

.me {
  background: linear-gradient(135deg, #eef6f0 0%, #f6f2e6 100%);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 32rpx; padding: 28rpx 30rpx; margin-top: 24rpx;
  font-size: calc(30rpx * var(--fs)); color: #3d5a48; line-height: 1.8;
  white-space: pre-line;
}

.tip {
  font-size: calc(27rpx * var(--fs));
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 28rpx; padding: 24rpx 26rpx; line-height: 1.75;
  margin-bottom: 20rpx; white-space: pre-line;
}

.ms {
  display: flex; align-items: center;
  background: var(--card); border: 0;
  box-shadow: var(--sh);
  border-radius: 30rpx; padding: 24rpx 26rpx; margin-bottom: 16rpx;
  transition: background .2s;
}
.ms.on { background: var(--ok-soft); box-shadow: none; }
.mck {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 4rpx solid var(--line); background: var(--bg2);
  flex: 0 0 auto; margin-right: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(30rpx * var(--fs)); font-weight: 700; color: #fff;
}
.ms.on .mck { background: var(--ok); border-color: var(--ok); }
.mb { flex: 1; min-width: 0; }
.mt { font-size: calc(32rpx * var(--fs)); font-weight: 600; line-height: 1.45; }
.mw { font-size: calc(25rpx * var(--fs)); color: var(--ok); margin-top: 8rpx; }

.note {
  background: var(--card); border: 0;
  box-shadow: var(--sh);
  border-radius: 30rpx; padding: 24rpx 26rpx; margin-bottom: 16rpx;
}
.nd { font-size: calc(25rpx * var(--fs)); color: var(--muted); }
.nt { font-size: calc(31rpx * var(--fs)); line-height: 1.65; margin-top: 10rpx; }

.foot { font-size: calc(25rpx * var(--fs)); color: var(--muted); margin-top: 38rpx; line-height: 1.6; text-align: center; }
