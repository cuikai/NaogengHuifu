.prog { display: flex; align-items: center; margin: 4rpx 0 10rpx; }
.prog-bar { flex: 1; height: 16rpx; border-radius: 99rpx; background: #e8e6de; overflow: hidden; }
.prog-in { height: 100%; background: var(--ok); border-radius: 99rpx; transition: width .25s; }
.prog-n { margin-left: 18rpx; font-size: calc(28rpx * var(--fs)); font-weight: 700; color: var(--ink2); flex: 0 0 auto; }

.tip {
  font-size: calc(28rpx * var(--fs));
  color: var(--blue-ink);
  background: var(--blue-soft);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
  margin-bottom: 18rpx;
}
.tip.mt { margin-top: 22rpx; }

.grid { display: flex; flex-wrap: wrap; margin: 0 -9rpx; }
.cell { width: 50%; box-sizing: border-box; padding: 0 9rpx 18rpx; }

.tk {
  position: relative;
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 26rpx;
  padding: 26rpx 22rpx 24rpx;
  height: 100%;
  box-sizing: border-box;
  text-align: center;
}
.tk.on { background: var(--ok-soft); border-color: var(--ok-line); }
.tki { width: 84rpx; height: 84rpx; }
.tkl { font-size: calc(34rpx * var(--fs)); font-weight: 700; margin-top: 8rpx; line-height: 1.3; }
.tkt { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-top: 8rpx; }
.tk.on .tkt { color: var(--ok); font-weight: 600; }
.tks { font-size: calc(24rpx * var(--fs)); color: var(--muted); margin-top: 4rpx; }
.tkc {
  position: absolute; right: 16rpx; top: 14rpx;
  font-size: calc(34rpx * var(--fs)); color: var(--ok); font-weight: 700;
}

/* ---------- 完成态 ---------- */
.ds { padding: 60rpx 10rpx 40rpx; text-align: center; }
.ds-tick { width: 150rpx; height: 150rpx; margin: 0 auto 26rpx; }
.ds-tick image { width: 100%; height: 100%; }
.ds-t { font-size: calc(50rpx * var(--fs)); font-weight: 700; margin-bottom: 20rpx; }
.ds-s { font-size: calc(32rpx * var(--fs)); color: var(--ink2); line-height: 1.8; }
.ds-box {
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: 24rpx; padding: 24rpx; margin: 36rpx 0 26rpx; text-align: left;
}
.ds-lb { font-size: calc(28rpx * var(--fs)); color: var(--ink2); margin-bottom: 12rpx; }
.ds-ta {
  width: 100%; min-height: 110rpx; box-sizing: border-box;
  border: 2rpx solid var(--line); border-radius: 18rpx; padding: 18rpx;
  font-size: calc(32rpx * var(--fs)); color: var(--ink); background: #fcfcfb;
}
.ph { color: #b6b2a5; }
.ds-rest { font-size: calc(28rpx * var(--fs)); color: var(--muted); margin-top: 30rpx; }
.ds-back { font-size: calc(28rpx * var(--fs)); color: var(--blue); margin-top: 40rpx; }
