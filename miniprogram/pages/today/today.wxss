.prog { display: flex; align-items: center; margin: 6rpx 0 12rpx; }
.prog-bar { flex: 1; height: 18rpx; border-radius: 99rpx; background: #ece5d6; overflow: hidden; }
.prog-in {
  height: 100%;
  background: linear-gradient(90deg, #7cc09a 0%, var(--ok) 100%);
  border-radius: 99rpx;
  transition: width .3s ease;
}
.prog-n { margin-left: 18rpx; font-size: calc(28rpx * var(--fs)); font-weight: 700; color: var(--ink2); flex: 0 0 auto; }

.tip {
  font-size: calc(28rpx * var(--fs));
  color: var(--blue-ink);
  background: var(--blue-soft);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  line-height: 1.75;
  margin-bottom: 20rpx;
}
.tip.mt { margin-top: 26rpx; }

.grid { display: flex; flex-wrap: wrap; margin: 0 -10rpx; }
.cell { width: 50%; box-sizing: border-box; padding: 0 10rpx 20rpx; }

.tk {
  position: relative;
  background: var(--card);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 34rpx;
  padding: 30rpx 22rpx 28rpx;
  height: 100%;
  box-sizing: border-box;
  text-align: center;
  transition: background .2s;
}
.tk.on { background: var(--ok-soft); box-shadow: none; }
.tki {
  width: 84rpx; height: 84rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border-radius: 24rpx;
  background: var(--bg2);
}
.tk.on .tki { background: #dcefe1; }
.tkl { font-size: calc(34rpx * var(--fs)); font-weight: 700; margin-top: 12rpx; line-height: 1.3; }
.tkt { font-size: calc(27rpx * var(--fs)); color: var(--muted); margin-top: 10rpx; }
.tk.on .tkt { color: var(--ok); font-weight: 600; }
.tks { font-size: calc(24rpx * var(--fs)); color: var(--muted); margin-top: 6rpx; }
.tkc {
  position: absolute; right: 18rpx; top: 16rpx;
  font-size: calc(34rpx * var(--fs)); color: var(--ok); font-weight: 700;
}

/* ---------- 完成态 ---------- */
.ds { padding: 70rpx 10rpx 40rpx; text-align: center; }
.ds-tick {
  width: 170rpx; height: 170rpx;
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 50%;
  background: var(--ok-soft);
  margin: 0 auto 30rpx;
}
.ds-tick image { width: 100%; height: 100%; }
.ds-t { font-size: calc(50rpx * var(--fs)); font-weight: 700; margin-bottom: 22rpx; letter-spacing: 1rpx; }
.ds-s { font-size: calc(32rpx * var(--fs)); color: var(--ink2); line-height: 1.9; }
.ds-box {
  background: var(--card); border: 0;
  box-shadow: var(--sh);
  border-radius: 32rpx; padding: 28rpx; margin: 40rpx 0 28rpx; text-align: left;
}
.ds-lb { font-size: calc(28rpx * var(--fs)); color: var(--ink2); margin-bottom: 14rpx; }
.ds-ta {
  width: 100%; min-height: 110rpx; box-sizing: border-box;
  border: 0; border-radius: 24rpx; padding: 22rpx;
  font-size: calc(32rpx * var(--fs)); color: var(--ink); background: var(--bg2);
  line-height: 1.6;
}
.ph { color: #b8b1a0; }
.ds-rest { font-size: calc(28rpx * var(--fs)); color: var(--muted); margin-top: 32rpx; }
.ds-back { font-size: calc(28rpx * var(--fs)); color: var(--blue-ink); margin-top: 44rpx; }
