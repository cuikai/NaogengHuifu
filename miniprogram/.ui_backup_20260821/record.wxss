.nums { display: flex; margin: 0 -8rpx; }
.nm {
  flex: 1; margin: 0 8rpx;
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: 24rpx; padding: 26rpx 10rpx; text-align: center;
}
.nv { font-size: calc(52rpx * var(--fs)); font-weight: 700; color: var(--blue); line-height: 1.1; }
.nl { font-size: calc(24rpx * var(--fs)); color: var(--muted); margin-top: 10rpx; }

.me {
  background: var(--ok-soft); border: 2rpx solid #d7e3d3;
  border-radius: 24rpx; padding: 24rpx 26rpx; margin-top: 22rpx;
  font-size: calc(30rpx * var(--fs)); color: #3d5138; line-height: 1.7;
  white-space: pre-line;
}

.tip {
  font-size: calc(27rpx * var(--fs));
  color: var(--blue-ink); background: var(--blue-soft);
  border-radius: 20rpx; padding: 20rpx 22rpx; line-height: 1.6;
  margin-bottom: 18rpx; white-space: pre-line;
}

.ms {
  display: flex; align-items: center;
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: 22rpx; padding: 22rpx 24rpx; margin-bottom: 14rpx;
}
.ms.on { background: var(--ok-soft); border-color: var(--ok-line); }
.mck {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 4rpx solid var(--line); background: #fff;
  flex: 0 0 auto; margin-right: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(30rpx * var(--fs)); font-weight: 700; color: #fff;
}
.ms.on .mck { background: var(--ok); border-color: var(--ok); }
.mb { flex: 1; min-width: 0; }
.mt { font-size: calc(32rpx * var(--fs)); font-weight: 600; line-height: 1.4; }
.mw { font-size: calc(25rpx * var(--fs)); color: var(--ok); margin-top: 6rpx; }

.note {
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: 22rpx; padding: 22rpx 24rpx; margin-bottom: 14rpx;
}
.nd { font-size: calc(25rpx * var(--fs)); color: var(--muted); }
.nt { font-size: calc(31rpx * var(--fs)); line-height: 1.55; margin-top: 8rpx; }

.foot { font-size: calc(25rpx * var(--fs)); color: var(--muted); margin-top: 34rpx; line-height: 1.6; }
