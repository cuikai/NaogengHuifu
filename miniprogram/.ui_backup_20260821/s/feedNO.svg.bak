      <ellipse cx="146" cy="50" rx="3.6" ry="4.8" fill="#e6b590" stroke="#c9885c" stroke-width="1.8"/>
    </g>
    <path d="M146 98 Q170 108 188 126 Q197 135 188 143 Q179 151 171 140 Q156 122 138 112 Z"
          fill="#f0c4a0" stroke="#c9885c" stroke-width="4"/>
