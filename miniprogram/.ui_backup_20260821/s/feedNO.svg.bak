      <circle cx="158" cy="46" r="25" fill="#f0c4a0" stroke="#c9885c" stroke-width="4"/>
      <path d="M133 45 Q134 21 158 21 Q182 21 183 43 Q172 31 156 32 Q142 33 133 45 Z" fill="#4a4038"/>
