  <!-- 勺子往上送、食物顺着仰头灌进去 -->
  <g transform="rotate(-30 104 50)">
    <ellipse cx="104" cy="50" rx="14" ry="8.5" fill="#dfe4ea" stroke="#8d97a4" stroke-width="3"/>
    <path d="M117 51 L150 56" stroke="#8d97a4" stroke-width="5"/>
    <path d="M146 42 q24 -2 26 13 q2 15 -15 16 q-17 1 -20 -11 Z" fill="#f5cba6" stroke="#c9885c" stroke-width="4"/>
  </g>

  <!-- 仰着头，食物直接灌向气管 -->
  <path d="M99 76 Q104 92 111 106" stroke="#c62f2f" stroke-width="4.5" stroke-dasharray="7 7"/>
  <path d="M104 104 l8 8 5 -10" stroke="#c62f2f" stroke-width="4.5"/>
</svg>