<svg width="260" height="200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 200" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <rect x="6" y="170" width="248" height="20" rx="9" fill="#ded9c9"/>
  <path d="M156 166 L82 90" stroke="#cdc7b4" stroke-width="22" stroke-linecap="round"/>

  <path d="M130 140 L214 146 Q228 147 229 158 Q230 171 217 172 L134 173 Q120 172 120 156 Q120 141 130 140 Z"
        fill="#a9c9ea" stroke="#6f9bd0" stroke-width="4"/>
  <path d="M222 144 q19 -2 21 12 q2 15 -13 16 h-10 Z" fill="#f0c4a0" stroke="#c9885c" stroke-width="4"/>

  <g transform="rotate(-42 152 168)">
    <path d="M143 60 h22 v32 h-22 Z" fill="#eab993"/>
    <path d="M132 168 Q126 128 130 98 Q132 82 152 80 Q174 78 178 96 Q184 130 182 168 Z"
          fill="#bcd6f2" stroke="#6f9bd0" stroke-width="4"/>
