page {
  /* ---------- 文字 ---------- */
  --ink: #33322b;
  --ink2: #5f5b51;
  --muted: #96907f;

  /* ---------- 底色与纸面（暖米） ---------- */
  --bg: #faf6ee;
  --bg2: #f3eee2;
  --card: #fffdf8;
  --line: #ece4d3;
  --line2: #f2ebdd;

  /* ---------- 主色：柔和草木绿 ---------- */
  --blue: #4f9a76;
  --blue-soft: #edf5f0;
  --blue-ink: #357054;

  /* ---------- 完成：更实一点的绿 ---------- */
  --ok: #3f8f5f;
  --ok-soft: #eaf4ec;
  --ok-line: #b7dcc0;

  /* ---------- 警示：保留醒目的红 ---------- */
  --no: #c8382f;
  --no-soft: #fdefec;
  --no-line: #eeb9b0;

  /* ---------- 提醒：暖杏 ---------- */
  --warn: #d98f3f;
  --warn-soft: #fdf6e8;
  --warn-line: #eeddb6;
  --warn-ink: #6b5320;

  /* ---------- 阴影：暖色、很淡 ---------- */
  --sh: 0 6rpx 20rpx rgba(150, 128, 92, 0.07);
  --sh2: 0 10rpx 28rpx rgba(150, 128, 92, 0.10);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 字号系数由 app.js 按屏宽算出来，写在根节点的 --fs 上 */
.pg {
  --fs: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.f-xs { font-size: calc(24rpx * var(--fs)); }
.f-sm { font-size: calc(28rpx * var(--fs)); }
.f-md { font-size: calc(32rpx * var(--fs)); }
.f-lg { font-size: calc(36rpx * var(--fs)); }
.f-xl { font-size: calc(44rpx * var(--fs)); }

/* ---------- 通用块 ---------- */
.card {
  background: var(--card);
  border: 0;
  box-shadow: var(--sh);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.h1 {
  font-size: calc(48rpx * var(--fs));
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
  margin: 34rpx 0 10rpx;
}
.lead {
  font-size: calc(32rpx * var(--fs));
  color: var(--ink2);
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.sec {
  font-size: calc(30rpx * var(--fs));
  font-weight: 700;
  color: var(--ink2);
  margin: 38rpx 0 16rpx;
  padding-left: 20rpx;
  position: relative;
}
.sec::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 8rpx; height: 28rpx;
  border-radius: 99rpx;
  background: var(--blue);
  opacity: .55;
}

/* ---------- 等比图片盒（不依赖 aspect-ratio，老设备也稳） ---------- */
.imgbox {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 24rpx;
}
.imgbox > image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 要点列表 ---------- */
.pt {
  display: flex;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line2);
}
.pt:last-child { border-bottom: 0; }
.pt .n {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: var(--blue-soft); color: var(--blue-ink);
  font-size: calc(30rpx * var(--fs)); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto; margin-top: 2rpx;
}
.pt .n.bad { background: var(--no-soft); color: var(--no); }
.pt .p { font-size: calc(33rpx * var(--fs)); font-weight: 600; line-height: 1.6; }
.pt .q { font-size: calc(27rpx * var(--fs)); color: var(--muted); line-height: 1.6; margin-top: 8rpx; }

/* ---------- 停止信号 ---------- */
.stop {
  background: var(--no-soft);
  border: 2rpx solid var(--no-line);
  border-radius: 32rpx;
  padding: 30rpx;
  margin-top: 32rpx;
}
.stop .t { font-size: calc(32rpx * var(--fs)); font-weight: 700; color: var(--no); margin-bottom: 12rpx; }
.stop .r { font-size: calc(29rpx * var(--fs)); color: #8a3a30; line-height: 1.7; margin-top: 10rpx; }
.stop .r .k { font-weight: 700; }

/* ---------- 出处 ---------- */
.why {
  background: var(--warn-soft);
  border: 2rpx solid var(--warn-line);
  border-radius: 32rpx;
  padding: 30rpx;
  margin-top: 32rpx;
  font-size: calc(29rpx * var(--fs));
  color: var(--warn-ink);
  line-height: 1.8;
}

/* ---------- 按钮 ---------- */
.btn {
  min-height: 112rpx;
  border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(34rpx * var(--fs)); font-weight: 700;
  border: 0;
  background: var(--card); color: var(--ink);
  box-shadow: var(--sh);
}
.btn.primary { background: var(--blue); color: #fff; box-shadow: 0 8rpx 20rpx rgba(79, 154, 118, 0.24); }
.btn.ok { background: var(--ok); color: #fff; box-shadow: 0 8rpx 20rpx rgba(63, 143, 95, 0.24); }
.btn.ghost { color: var(--ink2); background: var(--bg2); box-shadow: none; }
.btn.dis { opacity: 0.4; }

.hit { transition: opacity .14s, transform .14s; }
.hit:active { opacity: .7; transform: scale(.985); }
